<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ServiceBooking.Core\ServiceBooking.Core.csproj" />
    <ProjectReference Include="..\ServiceBooking.Infrastructure\ServiceBooking.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Sentry.Serilog" Version="4.13.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legal document text (ARCHITECTURE.md §4.1) is committed source, unlike the rest of App_Data —
         it has to ship in the build/publish output (and therefore the Docker image) so a container with
         no bind-mount over it still has a valid manifest to fail-fast against on first boot.

         Split in two, deliberately NOT a single `Content Update="App_Data\legal\**"`:
         - `legal.json` is already picked up by the Web SDK's default content glob (known content
           extension), so it only needs `Update` to add the CopyTo* metadata — `Include`-ing it again
           throws NETSDK1022 ("duplicate Content items were included").
         - `*.html` is NOT a default content extension, so `Update` on it (the previous, broken form of
           this ItemGroup, which used one `App_Data\legal\**` glob for both) matched no existing item and
           was silently a no-op: privacy.html/terms.html never made it into `dotnet publish`'s output
           (verified — only legal.json showed up under App_Data/legal in a published tree). It needs
           `Include`, which creates the item outright. -->
    <Content Update="App_Data\legal\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="App_Data\legal\**\*.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets ServiceBooking.UnitTests exercise ImageProcessor's internal pure helpers (orientation,
         crop, resize) directly with synthetic bitmaps, instead of hand-crafting real EXIF bytes just to
         reach them through the public Process() entry point (see ImageProcessor.ApplyOrigin doc). -->
    <InternalsVisibleTo Include="ServiceBooking.UnitTests" />
  </ItemGroup>

</Project>
