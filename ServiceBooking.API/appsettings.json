{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=servicebooking;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "CHANGE_ME_TO_A_LONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "ServiceBooking",
    "Audience": "ServiceBookingClient"
  },
  "AllowedOrigins": "http://localhost:5173",
  "SuperAdmin": {
    "Phone": "+70000000000",
    "Email": "admin@servicebooking.com",
    "Password": "Admin12345"
  },
  "SmartCaptcha": {
    "SecretKey": "",
    "SiteKey": ""
  },
  "Storage": {
    "PrivateRoot": "",
    "PublicRoot": "",
    "MinFreeDiskMb": 1024
  },
  "Uploads": {
    "MaxFileBytes": 5242880,
    "PerUserPerMinute": 10
  },
  "ForwardedHeaders": {
    "TrustedNetworks": []
  },
  "RateLimits": {
    "auth-login": { "PermitLimit": 10, "WindowMinutes": 1 },
    "auth-register": { "PermitLimit": 5, "WindowMinutes": 60 },
    "booking-create": { "PermitLimit": 120, "AnonymousPermitLimit": 10, "WindowMinutes": 60 },
    "availability": { "PermitLimit": 60, "WindowMinutes": 1 },
    "data-export": { "PermitLimit": 3, "WindowMinutes": 1440 },
    "subject-request": { "PermitLimit": 3, "WindowMinutes": 60 },
    "push-subscribe": { "PermitLimit": 20, "WindowMinutes": 60 },
    "address-verify": { "PermitLimit": 30, "WindowMinutes": 60 },
    "phone-verify-start": { "PermitLimit": 10, "WindowMinutes": 60 },
    "phone-change": { "PermitLimit": 5, "WindowMinutes": 60 },
    "phone-verify-webhook": { "PermitLimit": 600, "WindowMinutes": 1 }
  },
  "SubjectRequests": {
    "ResponseWorkingDays": 10
  },
  "Retention": {
    "NotificationBodyDays": 30,
    "NotificationMetadataDays": 365,
    "TemplateHistoryDays": 1095,
    "InactiveAccountDays": 1095,
    "BookingPersonalizationDays": 1095,
    "ClientNoteDays": 1095,
    "ClientNotePhotoDays": 365,
    "ClientHealthNoteDays": 1095,
    "ConsentRecordDays": 1095,
    "BookingEventDays": 0,
    "ChannelStateEventDays": 365,
    "PaymentLogDays": 1825,
    "MailLogDays": 365,
    "AppLogDays": 90,
    "AppLogDirectory": "",
    "PushSubscriptionDays": 180,
    "StaffPushNotificationDays": 365,
    "PhoneVerificationSessionDays": 1,
    "VerifiedPhoneOrphanDays": 365
  },
  "ScheduledTasks": {
    "Enabled": true,
    "TickSeconds": 60,
    "photo-retention-cleanup": {
      "Enabled": true,
      "MaxRunMinutes": 10
    },
    "notification-dispatch": {
      "Enabled": true,
      "MaxRunMinutes": 2
    },
    "channel-health": {
      "Enabled": true,
      "MaxRunMinutes": 10
    },
    "staff-push-dispatch": {
      "Enabled": true,
      "MaxRunMinutes": 2
    },
    "data-retention": {
      "Enabled": true,
      "MaxRunMinutes": 10,
      "DryRun": true,
      "BatchSize": 500
    },
    "max-webhook-renew": {
      "Enabled": true,
      "MaxRunMinutes": 2
    },
    "subject-request-due-soon": {
      "Enabled": true,
      "MaxRunMinutes": 2
    }
  },
  "Sentry": {
    "Dsn": "",
    "Release": ""
  },
  "Notifications": {
    "Provider": "logging",
    "EncryptionKey": "",
    "KeyRotationAck": "",
    "KeyFingerprintPath": "App_Data/state/.notifications-key-fingerprint",
    "PartnerToken": "",
    "WebhookToken": "",
    "UnsubscribeKey": "",
    "ProviderDeliveryConsent": "AccountsOnly",
    "GreenApi": {
      "ApiUrl": "https://api.green-api.com",
      "TimeoutSeconds": 15,
      "ServerCountry": "",
      "InstanceCreationEnabled": false,
      "ConnectPreference": "IPv4First",
      "ConnectTimeoutSeconds": 5,
      "PerAddressConnectTimeoutSeconds": 2
    },
    "GreenApiMax": {
      "ApiUrl": "https://api.green-api.com",
      "PartnerToken": ""
    },
    "Dispatch": {
      "BatchSize": 400,
      "BudgetSeconds": 50,
      "MaxParallelChannels": 8,
      "PauseMinMs": 5000,
      "PauseMaxMs": 15000,
      "InFlightGraceMinutes": 5,
      "MaxAttempts": 5
    },
    "ReminderJitterMinutes": 15,
    "UnauthorizedInstanceTimeoutMinutes": 15,
    "TestMessageCooldownMinutes": 5,
    "ConsecutiveFailureThreshold": 5,
    "AllowedRecipients": [],
    "StaffPush": {
      "Provider": "logging",
      "VapidPrivateKey": "",
      "VapidPublicKey": "",
      "VapidSubject": "",
      "MaxSubscriptionsPerUser": 10,
      "RequestTimeoutSeconds": 10,
      "Dispatch": {
        "BatchSize": 200,
        "BudgetSeconds": 20,
        "MaxParallelEndpoints": 8,
        "MaxAttempts": 4
      }
    }
  },
  "PhoneVerification": {
    "Provider": "stub",
    "SessionTtlMinutes": 10,
    "VerifiedSessionUsableMinutes": 30,
    "MaxPhonesPerExternalAccount": 3,
    "MaxOpenSessionsPerPhone": 3,
    "PollIntervalSeconds": 2,
    "ExternalKeyHmac": "",
    "Max": {
      "BotUsername": "",
      "BotToken": "",
      "ApiUrl": "https://platform-api.max.ru",
      "WebhookToken": "",
      "PublicBaseUrl": "",
      "TimeoutSeconds": 20,
      "GlobalRequestsPerSecond": 30,
      "PerChatMessagesPerSecond": 2,
      "MaxVcardBytes": 16384
    }
  },
  "Booking": {
    "DefaultWorkWindow": {
      "Start": "09:00",
      "End": "21:00"
    }
  },
  "AddressVerification": {
    "Provider": "logging",
    "StoreResults": false,
    "MaxCandidates": 5,
    "CacheHours": 24,
    "Yandex": {
      "ApiUrl": "https://geocode-maps.yandex.ru/1.x/",
      "ApiKey": "",
      "TimeoutSeconds": 5,
      "ConnectPreference": "IPv4First",
      "ConnectTimeoutSeconds": 5,
      "PerAddressConnectTimeoutSeconds": 2
    }
  }
}
