# .NET
bin/
obj/
*.user
.vs/
.idea/
*.suo
*.userprefs
appsettings.Development.json

# Deployment secrets
.env
.env.production
.deploy.env

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.production

# Docker
.dockerignore

# OS
.DS_Store
Thumbs.db

# Uploaded files (local disk storage — not committed)
ServiceBooking.API/wwwroot/uploads/**
!ServiceBooking.API/wwwroot/uploads/**/.gitkeep
# Private storage class default root (US-19, ARCHITECTURE.md §3.3) — dev-only default, same reasoning
# as the public uploads dir above. Legal document text (ARCHITECTURE.md §4.1) is the one exception: it
# is committed like code, so Development/Testing work out of the box and the text goes through review —
# unlike private-uploads, which only ever holds runtime-generated files.
ServiceBooking.API/App_Data/*
!ServiceBooking.API/App_Data/legal/

# Secrets
**/appsettings.*.json
!**/appsettings.json
# appsettings.Testing.json carries no secrets — just the Testing-environment overrides functional tests
# rely on (scheduler disabled, upload rate limit raised, ARCHITECTURE.md §8.5) — must be committed so
# the test suite behaves the same for every developer and in CI.
!ServiceBooking.API/appsettings.Testing.json
