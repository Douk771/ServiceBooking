# .NET
bin/
obj/
*.user
.vs/
.idea/
*.suo
*.userprefs
appsettings.Development.json

# Test run artifacts (dotnet test --collect etc.) — regenerated on every run, not source
TestResults/

# Deployment secrets
.env
.env.production
.deploy.env

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.production

# OS
.DS_Store
Thumbs.db

# Uploaded files (local disk storage — not committed)
ServiceBooking.API/wwwroot/uploads/**
!ServiceBooking.API/wwwroot/uploads/**/.gitkeep
# Private storage class default root (US-19, ARCHITECTURE.md §3.3) — dev-only default, same reasoning
# as the public uploads dir above. Legal document text (ARCHITECTURE.md §4.1) is the one exception: it
# is committed like code, so Development/Testing work out of the box and the text goes through review —
# unlike private-uploads, which only ever holds runtime-generated files.
ServiceBooking.API/App_Data/*
!ServiceBooking.API/App_Data/legal/

# Serilog's rolling file sink (US-45, ARCHITECTURE.md §11.1) — a runtime artifact, not data or config.
ServiceBooking.API/logs/

# Repo-root /logs — QA/local run logs (app-*.json when the API is launched with cwd=repo root instead
# of ServiceBooking.API/, plus ad-hoc contract-check/schemathesis run logs). Same reasoning as
# ServiceBooking.API/logs/ above: a runtime artifact of running the app/tools locally, not source.
/logs/

# schemathesis's own working directory (contract checks against contracts/openapi-cycle5.yaml) —
# cassettes/state from local runs, not something to commit.
/.schemathesis/

# Repo-root /legal — the operator-owned directory docker-compose.prod.yml bind-mounts onto the VPS
# (DEPLOY.md §2.1, ARCHITECTURE.md §4.1). It only exists on the VPS itself, created there from the
# committed ServiceBooking.API/App_Data/legal draft; never meant to be a tracked path in this repo.
/legal/

# Repo-root /state — writable bind-mount target for the notifications master-key fingerprint file
# (ARCHITECTURE_CYCLE4.md §24.5, docker-compose.prod.yml, DEPLOY.md §3/§4/§11). Host-local operator
# data, created on the VPS before first `docker compose up`; never meant to be a tracked path here,
# same treatment as /legal/ above and .env.
/state/

# Secrets
**/appsettings.*.json
!**/appsettings.json
# appsettings.Testing.json carries no secrets — just the Testing-environment overrides functional tests
# rely on (scheduler disabled, upload rate limit raised, ARCHITECTURE.md §8.5) — must be committed so
# the test suite behaves the same for every developer and in CI.
!ServiceBooking.API/appsettings.Testing.json
