<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>ServiceBooking.LegalKit</RootNamespace>
    <AssemblyName>ServiceBooking.LegalKit</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ARCHITECTURE_CYCLE11.md §104.1: LegalKit references ServiceBooking.API as a library and reuses
         LegalDocumentProvider.LoadStrict()/PlaceholderPattern rather than re-implementing the manifest
         rules — the same way ServiceBooking.Tests already does. Nothing here starts the API's host,
         DI container, or Program.cs. -->
    <ProjectReference Include="..\ServiceBooking.API\ServiceBooking.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ServiceBooking.UnitTests exercises the internal build/scan/publish logic directly (temp
         directories, no host, no DB) — same InternalsVisibleTo pattern ServiceBooking.API already uses
         for ImageProcessor's internal helpers. -->
    <InternalsVisibleTo Include="ServiceBooking.UnitTests" />
  </ItemGroup>

</Project>
