# Демо-стенд demo.visit.ezbook.ru и demo.zakaz.ezbook.ru (docker-compose.demo.yml, DEPLOY.md §25, §27).
# cp .env.demo.example .env.demo  — и заполнить. Файл .env.demo в git не попадает (.gitignore).
# Строки CHANGE_ME нужно ЗАМЕНИТЬ: API отвергает заглушки при старте. Секреты НЕ те же, что на бою (кроме ключа капчи).

# ---------- Секреты (свои, не боевые) ----------
# Только буквы и цифры (openssl rand -hex 24): пароль подставляется в строку подключения, «;» и «=» её ломают
DEMO_POSTGRES_PASSWORD=CHANGE_ME
# openssl rand -base64 48  (не короче 32 символов; ОТЛИЧАТЬСЯ от боевого JWT_KEY)
DEMO_JWT_KEY=CHANGE_ME
DEMO_SUPERADMIN_PHONE=+70000000000
# Не заглушка («CHANGE_ME», «Admin12345» API не принимает), проходит политику паролей: буквы обоих регистров и цифра
DEMO_SUPERADMIN_PASSWORD=CHANGE_ME
# Ключ проверки «пробный один раз на телефон»: без него API в Production не стартует (ValidateTrialSecrets).
# openssl rand -base64 32  (свой, не боевой TRIAL_PHONEKEY_HMAC); идентификатор до 16 символов
DEMO_TRIAL_PHONEKEY_HMAC=CHANGE_ME
DEMO_TRIAL_PHONEKEY_ID=k1
# Ключ капчи ТОТ ЖЕ, что в боевом .env (SMARTCAPTCHA_SECRET_KEY); хост demo.visit.ezbook.ru добавляется в консоли SmartCaptcha.
# Пусто = гостевая запись на демо отвечает «Invalid captcha» (запись под ролью клиента работает).
SMARTCAPTCHA_SECRET_KEY=

# ---------- Сеть ----------
# Подсеть compose-проекта ezbook-demo и доверенная сеть для X-Forwarded-For — ОДНО И ТО ЖЕ значение.
DEMO_NETWORK_SUBNET=172.30.77.0/24
DEMO_FORWARDEDHEADERS__TRUSTEDNETWORKS__0=172.30.77.0/24
DEMO_API_PORT=5001

# ---------- Демо-режим и замки (ValidateDemoMode): значения ниже — те, что проходят проверку. Обычно не менять ----------
DEMO_MODE_ENABLED=true
DEMO_RESET_LOCAL_TIME=04:00
DEMO_TIMEZONE_ID=Europe/Moscow
# Хост должен начинаться с «demo.»
DEMO_PUBLIC_BASE_URL=https://demo.visit.ezbook.ru
# Адрес «Заказов» (demo.zakaz, цикл 35): тоже обязан начинаться с «demo.», иначе API не стартует (замок OrdersBaseUrl)
DEMO_ORDERS_BASE_URL=https://demo.zakaz.ezbook.ru
# Оба origin через запятую (один API на два vhost). ВНИМАНИЕ: если в уже существующем .env.demo на машине задан
# DEMO_ALLOWED_ORIGINS только с demo.visit — допишите demo.zakaz (или удалите строку, возьмётся значение по умолчанию).
DEMO_ALLOWED_ORIGINS=https://demo.visit.ezbook.ru,https://demo.zakaz.ezbook.ru
# Издатель токенов оканчивается на «.Demo»; имя БД (servicebooking_demo) зашито в compose и оканчивается на «_demo»
DEMO_JWT_ISSUER=ServiceBooking.Demo
DEMO_JWT_AUDIENCE=ServiceBookingClient.Demo
# Демо ничего никому не отправляет
DEMO_NOTIFICATIONS_PROVIDER=logging
DEMO_STAFFPUSH_PROVIDER=logging
DEMO_STAFFMAX_ENABLED=false
DEMO_PHONEVERIFY_PROVIDER=stub
# Ночной сброс вместо еженедельного пересева витрины
DEMO_SHOWCASE_RESEED_ENABLED=false

# ---------- Только для deploy-remote.sh (боевой .env, НЕ этот файл) ----------
# DEMO_ENABLED=true   — включает шаг «обновить демо» в конце боевого выката (по умолчанию выключен)
# DEMO_ZAKAZ_ENABLED=true — дополнительно гоняет смоук demo.zakaz (deploy/ci/demo-zakaz-smoke.sh) после выката
