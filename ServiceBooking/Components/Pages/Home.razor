@page "/"
@using ServiceBooking.Services
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Home</PageTitle>

<div id="calendar"></div>

@code {
    List<TimeSlot> slots = [];
    private string eventsJson = "[]";

    protected override async Task OnInitializedAsync()
    {
        //slots = new List<TimeSlot>() {new TimeSlot() {}};
        
        slots = new List<TimeSlot>
        {
            new TimeSlot
            {
                Id = Guid.NewGuid(),
                Date = new DateOnly(2025, 1, 10),
                Start = new TimeOnly(10, 0),
                End = new TimeOnly(11, 0),
                IsAvailable = true
            },
            new TimeSlot
            {
                Id = Guid.NewGuid(),
                Date = new DateOnly(2025, 1, 10),
                Start = new TimeOnly(11, 0),
                End = new TimeOnly(12, 0),
                IsAvailable = true
            },
            new TimeSlot
            {
                Id = Guid.NewGuid(),
                Date = new DateOnly(2025, 1, 10),
                Start = new TimeOnly(13, 0),
                End = new TimeOnly(14, 0),
                IsAvailable = true
            }
        };
        
        
        // Преобразуем в формат FullCalendar
        var events = slots.Select(s => new
        {
            id = s.Id.ToString(),
            title = s.IsAvailable ? "Свободно" : "Занято",
            start = new DateTime(s.Date.Year, s.Date.Month, s.Date.Day, s.Start.Hour, s.Start.Minute, 0).ToString("s"),
            end = new DateTime(s.Date.Year, s.Date.Month, s.Date.Day, s.End.Hour, s.End.Minute, 0).ToString("s"),
            color = s.IsAvailable ? "green" : "red"
        }).ToList();

        eventsJson = System.Text.Json.JsonSerializer.Serialize(events);
    //    await JS.InvokeVoidAsync("calendarInterop.init", "calendar", eventsJson);
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JS Interop можно вызывать только после первого рендера
            await JS.InvokeVoidAsync("calendarInterop.init", "calendar", eventsJson);
        }
    }

    [JSInvokable("OnEventClick")]
    public static void OnEventClick(string slotId)
    {
        // В проде используйте NavigationManager через DI
        Console.WriteLine($"Clicked slot: {slotId}");
    }

}