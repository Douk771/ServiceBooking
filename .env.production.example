# Copy this file to `.env` on the VPS (same directory as docker-compose.prod.yml) and fill in real values.
# `.env` itself must never be committed to git.

DOMAIN=ezbook.ru

# Strong random password for the Postgres container (generate with: openssl rand -base64 24)
POSTGRES_PASSWORD=CHANGE_ME

# JWT signing key — at least 32 random characters (generate with: openssl rand -base64 48).
# REQUIRED: the API fails to start in Production if this is missing, shorter than 32 characters, or
# still equal to this placeholder (fail-fast, see Program.cs).
JWT_KEY=CHANGE_ME_TO_A_LONG_SECRET_KEY_AT_LEAST_32_CHARS

# Phone number (in the app's normalized format, e.g. +79991234567) that should be seeded/promoted to SuperAdmin on first run
SUPERADMIN_PHONE=+70000000000

# Password for the seeded SuperAdmin account — REQUIRED. The API fails to start in Production if this
# is missing or still equal to a placeholder ("Admin12345" or "CHANGE_ME"), see the fail-fast in
# Program.cs. It must also satisfy the Identity policy: at least 8 characters, with a digit, an
# uppercase and a lowercase letter — otherwise seeding the account fails on first run.
SUPERADMIN_PASSWORD=CHANGE_ME

# Yandex SmartCaptcha keys — from https://cloud.yandex.ru/services/smartcaptcha
SMARTCAPTCHA_SECRET_KEY=
SMARTCAPTCHA_SITE_KEY=

# Trusted proxy network(s) for X-Forwarded-For (ARCHITECTURE.md §9.1) — the docker bridge subnet compose
# assigns to this stack, CIDR notation, comma-separated if more than one (e.g. 172.16.0.0/12). REQUIRED:
# the API fails to start in Production if this is empty — an empty trusted-network list would mean the
# rate limiter partitions every caller under the SAME key (nginx's address), which is a denial-of-service
# footgun, not a limiter (fail-fast, see Program.cs).
FORWARDEDHEADERS__TRUSTEDNETWORKS__0=172.16.0.0/12

# Storage__PrivateRoot is set directly in docker-compose.prod.yml (/app/private-uploads, backed by the
# api_private_uploads named volume) — nothing to configure here. It exists purely so client-note photos
# never live under wwwroot/uploads (the public, api_uploads volume) — see ARCHITECTURE.md §3, DEPLOY.md
# "Два класса хранения". Back up BOTH volumes; api_private_uploads holds personal data.
