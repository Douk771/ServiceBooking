# Copy this file to `.env` on the VPS (same directory as docker-compose.prod.yml) and fill in real values.
# `.env` itself must never be committed to git.

DOMAIN=ezbook.ru

# Strong random password for the Postgres container (generate with: openssl rand -base64 24)
POSTGRES_PASSWORD=CHANGE_ME

# JWT signing key — at least 32 random characters (generate with: openssl rand -base64 48).
# REQUIRED: the API fails to start in Production if this is missing, shorter than 32 characters, or
# still equal to this placeholder (fail-fast, see Program.cs).
JWT_KEY=CHANGE_ME_TO_A_LONG_SECRET_KEY_AT_LEAST_32_CHARS

# Phone number (in the app's normalized format, e.g. +79991234567) that should be seeded/promoted to SuperAdmin on first run
SUPERADMIN_PHONE=+70000000000

# Password for the seeded SuperAdmin account — REQUIRED. The API fails to start in Production if this
# is missing or still equal to a placeholder ("Admin12345" or "CHANGE_ME"), see the fail-fast in
# Program.cs. It must also satisfy the Identity policy: at least 8 characters, with a digit, an
# uppercase and a lowercase letter — otherwise seeding the account fails on first run.
SUPERADMIN_PASSWORD=CHANGE_ME

# Yandex SmartCaptcha keys — from https://cloud.yandex.ru/services/smartcaptcha
SMARTCAPTCHA_SECRET_KEY=
SMARTCAPTCHA_SITE_KEY=

# Trusted proxy network(s) for X-Forwarded-For (ARCHITECTURE.md §9.1) — the docker bridge subnet compose
# assigns to this stack, CIDR notation, comma-separated if more than one (e.g. 172.16.0.0/12). REQUIRED:
# the API fails to start in Production if this is empty — an empty trusted-network list would mean the
# rate limiter partitions every caller under the SAME key (nginx's address), which is a denial-of-service
# footgun, not a limiter (fail-fast, see Program.cs).
FORWARDEDHEADERS__TRUSTEDNETWORKS__0=172.16.0.0/12

# Storage__PrivateRoot is set directly in docker-compose.prod.yml (/app/private-uploads, backed by the
# api_private_uploads named volume) — nothing to configure here. It exists purely so client-note photos
# never live under wwwroot/uploads (the public, api_uploads volume) — see ARCHITECTURE.md §3, DEPLOY.md
# "Два класса хранения". Back up BOTH volumes; api_private_uploads holds personal data.
#
# Storage__PublicRoot is NOT set anywhere in this stack — it defaults to wwwroot/uploads, which is what
# UseStaticFiles serves at /uploads/... (see DEPLOY.md "Два класса хранения"). Only set it if you need a
# dedicated volume/disk for public files; if you do, it must not equal or sit above the container's
# content root (/app) — the API fails to start in Production if it does, because that would make
# UseStaticFiles serve the application's own files (appsettings, DLLs, App_Data) at /uploads/... to
# anyone. Keeping it unset is the supported default.

# --- Notifications (cycle 4, WhatsApp via GREEN-API) — ARCHITECTURE_CYCLE4.md §24, §37 ---

# Master key for encrypting each salon's WhatsApp channel token at rest (AES-GCM, §24.1) — base64 of
# EXACTLY 32 random bytes (generate with: openssl rand -base64 32). REQUIRED once a real provider is
# configured (NOTIFICATIONS_PROVIDER=green-api): the API fails to start in Production without it, or
# if it isn't valid base64/32 bytes/still this placeholder.
#
# DO NOT regenerate this together with the other secrets above during a routine post-incident key
# rotation — see DEPLOY.md "Инвентарь секретов", separate line. It is deliberately NOT rotated by
# just changing the value: doing so silently disconnects every salon's WhatsApp channel (they can
# only be reconnected via QR, one by one, by their owners). Losing it is irreversible — restore ONLY
# from a `.env` backup (deploy/backup/backup.sh). Legal rotation procedure: DEPLOY.md §11 "Ротация
# ключа шифрования каналов" (ARCHITECTURE_CYCLE4.md §24.4).
NOTIFICATIONS_ENCRYPTION_KEY=CHANGE_ME_32_RANDOM_BYTES_BASE64

# One-time acknowledgement for a deliberate key rotation (§24.4) — normally EMPTY. Only set this
# (to the new key's 8-hex-char fingerprint, see the rotation procedure) for the single deploy that
# performs the rotation, then remove it again. Leaving it set silently disables the fingerprint
# fail-fast check (§24.5) on every future start — do not leave this filled in "just in case".
NOTIFICATIONS_KEY_ROTATION_ACK=

# `logging` (default) writes messages to the app log instead of sending them — safe for any
# environment, including this one until a provider is deliberately turned on. Set to `green-api` to
# actually send WhatsApp messages through GREEN-API; doing so makes the three variables below
# REQUIRED (the API fails to start in Production without them, per DeploymentSafetyChecks).
NOTIFICATIONS_PROVIDER=logging

# GREEN-API partner token (from your GREEN-API partner cabinet) — used to create/manage WhatsApp
# instances on salons' behalf. REQUIRED when NOTIFICATIONS_PROVIDER=green-api in Production. TRAP:
# outside Production this MUST be left EMPTY (ARCHITECTURE_CYCLE4.md §24.2 п.3) — the API fails to
# start in Production if it's missing, but also fails to start in non-Production environments if this
# is non-empty, specifically to stop a dev/staging run from ever touching a real salon's instance.
NOTIFICATIONS_PARTNER_TOKEN=

# GREEN-API partner token for the SEPARATE MAX product/account (ARCHITECTURE_CYCLE9.md §104.1/§104.9)
# — MAX is not the same partner account as WhatsApp, so it gets its own token here. Same rules as
# NOTIFICATIONS_PARTNER_TOKEN above: REQUIRED when NOTIFICATIONS_PROVIDER=green-api in Production,
# and MUST be left EMPTY outside Production.
NOTIFICATIONS_GREENAPI_MAX_PARTNER_TOKEN=

# Random token embedded in the provider webhook URL (POST /api/notifications/provider-webhook/{token})
# — generate with: openssl rand -base64 32. This value is sent TO GREEN-API when registering the
# webhook, unlike the other Notifications secrets below. REQUIRED when NOTIFICATIONS_PROVIDER=green-api
# in Production.
NOTIFICATIONS_WEBHOOK_TOKEN=CHANGE_ME_RANDOM_TOKEN

# Signing key for the public unsubscribe link (GET/POST /api/notifications/unsubscribe/{token}) —
# generate with: openssl rand -base64 32. Never sent anywhere (§31.4), unlike the webhook token above.
# REQUIRED when NOTIFICATIONS_PROVIDER=green-api in Production.
NOTIFICATIONS_UNSUBSCRIBE_KEY=CHANGE_ME_RANDOM_KEY

# --- Web Push мастеру (cycle 9, проход C — ARCHITECTURE_CYCLE9.md §105) ---

# `logging` (default) — the subsystem stays OFF platform-wide (SPEC П13's documented
# "невыпущенность"): GET /api/push/config answers enabled=false, nobody is offered a subscribe toggle,
# and the three variables below are not required. Set to `web-push` to actually deliver Web Push,
# which makes all three REQUIRED (the API fails to start in Production without them).
WEBPUSH_STAFFPUSH_PROVIDER=logging

# VAPID key pair (RFC 8292), base64url — generate with: `npx web-push generate-vapid-keys` (or any
# other RFC-8292-compliant generator). REQUIRED when WEBPUSH_STAFFPUSH_PROVIDER=web-push in Production;
# the API fails to start without a pair that actually parses as P-256 (DeploymentSafetyChecks).
# NOT the same secret/rotation procedure as NOTIFICATIONS_ENCRYPTION_KEY above — losing/rotating this
# pair does not lose any DATA, it just invalidates every existing browser subscription at once (they
# were created against the OLD public key); see ARCHITECTURE_CYCLE9.md §105.2 for the "what to do"
# runbook. VapidPublicKey is NOT a secret on its own (it is handed to every browser by
# GET /api/push/config) — kept alongside the private key here anyway, for the same reason
# NOTIFICATIONS_PARTNER_TOKEN and its Production-only counterpart live in one place.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY

# VAPID JWT `sub` claim (RFC 8292) — a mailto: or https: URL identifying the platform to the push
# service. REQUIRED when WEBPUSH_STAFFPUSH_PROVIDER=web-push in Production.
WEBPUSH_VAPID_SUBJECT=mailto:ops@ezbook.ru

# --- Retention (cycle 5, DEPLOY.md §11.4) ---
# Whether the "delete by retention age" scheduled task actually deletes anything, or only logs what it
# WOULD delete. Leave unset/true on the first deploy of this feature — see DEPLOY.md §11.4 for the
# required dry-run-first procedure before ever setting this to false.
RETENTION_DRY_RUN=true

# GlitchTip DSN (T-D4, US-45, ARCHITECTURE.md §11.4/§11.5) — from your GlitchTip project's settings
# page, same DSN format as Sentry: https://<key>@<host>/<project_id>. OPTIONAL: leave empty and the
# app runs fine without an error tracker (no fail-fast on this one, unlike Jwt/SuperAdmin above) — but
# deploy/backup/backup.sh also reuses this same variable to send a "backup failed" event, so filling it
# in gets you both error tracking and backup-failure alerts from one setting.
SENTRY_DSN=

# Optional: short git commit hash of the deployed code, shown as "Release" on every event in
# GlitchTip so you can tell which deploy an error came from. deploy/deploy-remote.sh sets this
# automatically from `git rev-parse --short HEAD`; only needed here if you deploy some other way.
GIT_SHA=

# --- GlitchTip (T-D4, DEPLOY.md §12) — only needed if you run docker-compose.glitchtip.yml on this box ---
# Separate Postgres password for GlitchTip's OWN database (glitchtip, not servicebooking) — generate
# with: openssl rand -base64 24
GLITCHTIP_POSTGRES_PASSWORD=CHANGE_ME

# Django secret key for GlitchTip — generate with: openssl rand -base64 48
GLITCHTIP_SECRET_KEY=CHANGE_ME

# Subdomain GlitchTip is served on — WITHOUT https://, docker-compose.glitchtip.yml adds the scheme
# itself. nginx proxies to it (deploy/nginx/errors.ezbook.conf), behind basic-auth in front of
# GlitchTip's own login; do not expose the container's port directly. See DEPLOY.md §12.
GLITCHTIP_DOMAIN=errors.ezbook.ru

# SMTP URL for GlitchTip's own alert emails, format: smtp://user:pass@host:port (special characters
# in the password must be URL-encoded, e.g. "@" -> "%40"). TRAP: leaving this empty falls back to
# consolemail:// (the default in docker-compose.glitchtip.yml), which silently logs "would have
# sent" to the container's stdout and never actually sends anything — i.e. no email alerts at all,
# with no error telling you so. For a normal mailbox (Yandex, Mail.ru, etc.) this must be an
# APPLICATION password generated in that mailbox's security settings, not the mailbox's own login
# password — providers reject plain passwords over SMTP. See DEPLOY.md §12.2.1.
GLITCHTIP_EMAIL_URL=
GLITCHTIP_FROM_EMAIL=glitchtip@ezbook.ru
