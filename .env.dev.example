# Cycle 8 env contract (API_CONTRACT_CYCLE8.md §85) — working-copy environment for the LOCAL dev
# stack (`docker compose up`, `npm run dev`). Copy this file to `.env` in the repo root and adjust
# what you need; `.env` itself is gitignored (see .gitignore) and never committed.
#
# Every variable below already has a working default baked into docker-compose.yml and
# frontend/vite.config.ts — a fresh clone with NO `.env` at all runs exactly as it did before cycle 8,
# on ports 5432/5000/5173. You only need this file if you run more than one working copy of this repo
# on the same machine at once and need to keep them from colliding on published ports. Compose
# already keeps the project name, containers, network and volume apart per checkout directory — see
# the header of docker-compose.yml for why that derivation is left alone.
#
# This is not a secrets file: every value here is a placeholder/default, safe to look at in a public
# repo. Real secrets for a deployed environment live in .env.production.example instead.

# Name of the docker compose project. Leave this COMMENTED OUT unless you have a reason: with no
# value, compose derives the project name from the checkout directory, which is what keeps two
# working copies of this repo from sharing containers, network and volume. Set it only to pin a
# name deliberately (e.g. two stacks that must share one project, or a directory whose name compose
# rejects). Must match ^[a-z0-9][a-z0-9_-]{0,30}$. COMPOSE_PROJECT_NAME is compose's own variable —
# it namespaces everything at once, so there is no separate volume knob to keep in sync.
# COMPOSE_PROJECT_NAME=servicebooking

# Host port Postgres is published on. Change this (together with SB_API_PORT below) when running a
# second dev stack on the same machine so the two don't fight over the same host port.
SB_DB_PORT=5432

# Name of the Postgres database the api container connects to and docker-compose creates.
SB_DB_NAME=servicebooking

# Host port the API container publishes 8080 on. Also read by frontend/vite.config.ts to build the
# default Vite dev-server proxy target (http://localhost:$SB_API_PORT) — keep this in sync with
# whatever port you actually run the API container on.
SB_API_PORT=5000

# Port the Vite dev server (`npm run dev`) listens on, and the port docker-compose's api container
# trusts as AllowedOrigins for CORS. Vite never fails on a taken port (no strictPort, US-89) — if this
# port is busy it just picks the next free one and prints the actual address — but keep this set to
# whatever you expect the frontend to actually be on, so AllowedOrigins matches.
SB_WEB_PORT=5173

# Host port for the optional GlitchTip stack (docker-compose.glitchtip.yml) — a production-server
# tool, not something you normally run locally. Left here for completeness/symmetry with the
# contract table in API_CONTRACT_CYCLE8.md §85.
SB_GLITCHTIP_PORT=8000

# Cycle-3 override for the Vite dev-server API proxy target — takes priority over SB_API_PORT when
# set (API_CONTRACT_CYCLE8.md §85.3). Leave unset unless you're pointing the frontend at an API that
# isn't the docker-compose one, e.g. a remote/staging backend.
# VITE_API_TARGET=http://localhost:5000
