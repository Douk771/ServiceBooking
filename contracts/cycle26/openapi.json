{
  "openapi": "3.0.3",
  "info": {
    "title": "ServiceBooking API — цикл 26 (единая карточка компании)",
    "version": "26.1.0",
    "license": {
      "name": "Proprietary"
    },
    "description": "Конвенции проекта без изменений: camelCase; enum — строкой; DateTime — ISO-8601 UTC; DateOnly — \"YYYY-MM-DD\";\n400/402/429 — голая строка по-русски; 401/403 — пустое тело; 404 — пустое тело, не оракул; 409 маршрутов\n/api/companies/* — голая строка; 409 домена магазина — JSON (CatalogConflictDto). Текст, который видит человек,\nсобирает сервер.\n\nГЛАВНЫЕ ПРАВИЛА ЦИКЛА, ЗАКРЕПЛЁННЫЕ ФОРМОЙ:\n  1. Фото магазина приходят ВМЕСТЕ с витриной (StorefrontDto.photos), отдельного запроса витрина не делает.\n     У заблокированного магазина (isAvailable = false) photos — пустой массив.\n  2. Галерея — одна для салона и магазина: те же маршруты, те же права (владелец, SuperAdmin), тот же лимит 10.\n  3. Часовой пояс магазина задаётся только городом. Смена города на город с другим смещением UTC при\n     существующих заказах запрещена (409); кабинет узнаёт это заранее по ShopManageDto.timeZoneChangeAllowed.\n  4. «Город, адрес» собирает ФРОНТ одной функцией (publicAddress); сервер отдаёт cityName и address раздельно.\n"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "dev (dotnet run)"
    },
    {
      "url": "http://localhost:4026",
      "description": "prism mock по этой схеме"
    }
  ],
  "tags": [
    {
      "name": "company-photos",
      "description": "Галерея фото компании — салона и (с цикла 26) магазина."
    },
    {
      "name": "company-profile",
      "description": "Профиль компании — поля карточки, адрес. Магазин пишет свой профиль этими же маршрутами."
    },
    {
      "name": "shops",
      "description": "Магазин для кабинета goods (ShopManageDto)."
    },
    {
      "name": "storefront",
      "description": "Публичная страница магазина — единая карточка компании и ассортимент на дату."
    }
  ],
  "paths": {
    "/api/companies/{id}/photos": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CompanyId"
        }
      ],
      "get": {
        "tags": [
          "company-photos"
        ],
        "operationId": "getCompanyPhotosCycle26",
        "summary": "Фото компании (салона или магазина) — анонимно",
        "description": "Без изменений. Компания не найдена или деактивирована → 404. Кабинет goods читает галерею здесь.",
        "security": [],
        "responses": {
          "200": {
            "description": "Фото в порядке показа; пустой массив, если фото нет.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "$ref": "#/components/schemas/CompanyPhotoDto"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "tags": [
          "company-photos"
        ],
        "operationId": "uploadCompanyPhotoCycle26",
        "summary": "Загрузить фото компании (с цикла 26 — и магазина)",
        "description": "Порядок проверок: 401 → компания не найдена 404 → не владелец и не SuperAdmin 403 → файл 400 → дубль по хешу 200 →\nлимит 10 → 400 (текст зависит от типа компании, §560.2) → 201. Для магазина 409 больше НЕ отвечает.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG / PNG / WEBP, не больше 5 МБ."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Этот файл уже загружен — возвращается существующее фото, дубль не создаётся.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyPhotoDto"
                }
              }
            }
          },
          "201": {
            "description": "Фото загружено, добавлено в конец.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyPhotoDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PlainTextError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/companies/{id}/photos/{photoId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CompanyId"
        },
        {
          "$ref": "#/components/parameters/PhotoId"
        }
      ],
      "delete": {
        "tags": [
          "company-photos"
        ],
        "operationId": "deleteCompanyPhotoCycle26",
        "summary": "Удалить фото компании (с цикла 26 — и магазина)",
        "description": "Порядок: reason неизвестный → 400 → компания 404 → права 403 → фото этой компании нет → 404 → 204.\nreason=DepictedPersonRequest учитывается только от SuperAdmin (уведомление владельцу, текст нейтральный «компании»).\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "reason",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "DepictedPersonRequest"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "$ref": "#/components/responses/NoContent"
          },
          "400": {
            "$ref": "#/components/responses/PlainTextError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/companies/{id}/photos/order": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CompanyId"
        }
      ],
      "put": {
        "tags": [
          "company-photos"
        ],
        "operationId": "reorderCompanyPhotosCycle26",
        "summary": "Порядок фото компании (первое — обложка; с цикла 26 — и магазина)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReorderCompanyPhotosDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Новый порядок.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "$ref": "#/components/schemas/CompanyPhotoDto"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PlainTextError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/companies/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CompanyId"
        }
      ],
      "put": {
        "tags": [
          "company-profile"
        ],
        "operationId": "updateCompanyProfileCycle26",
        "summary": "Поля карточки компании (салона или магазина)",
        "description": "Форма прежняя. Изменение цикла 26 — только для магазина (Kind = Orders), §563:\n  * timeZoneId со значением, отличным от пояса города → 400 «Часовой пояс магазина задаётся городом»;\n  * смена города всегда ставит пояс города (ручной пояс сбрасывается);\n  * новый пояс с другим смещением UTC при существующих заказах → 409 (голая строка = timeZoneChangeLockedText).\nЗапрос атомарен: при 400/409 ничего из тела не сохраняется. Салон — без изменений.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCompanyProfileInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Компания после сохранения (CompanyDto).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyProfileDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PlainTextError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/PlainTextConflict"
          },
          "451": {
            "$ref": "#/components/responses/LegalGate"
          }
        }
      }
    },
    "/api/companies/{id}/address": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CompanyId"
        }
      ],
      "put": {
        "tags": [
          "company-profile"
        ],
        "operationId": "saveCompanyAddressCycle26",
        "summary": "Адрес компании (без изменений; профиль магазина пишет адрес здесь)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveCompanyAddressInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Компания после сохранения.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyAddressUpdateResultDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PlainTextError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/shops/{shopId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ShopId"
        }
      ],
      "get": {
        "tags": [
          "shops"
        ],
        "operationId": "getShopCycle26",
        "summary": "Магазин для кабинета — с полями смены города (цикл 26)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "ShopManageDto цикла 26.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopManageDto"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/storefront/{slug}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Slug"
        }
      ],
      "get": {
        "tags": [
          "storefront"
        ],
        "operationId": "getStorefrontCycle26",
        "summary": "Страница магазина — карточка (с фото и email) и ассортимент на дату",
        "security": [],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Дата выдачи; не передана — сегодня. Недоступная дата → ассортимент на сегодня + dateNotice.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Магазин и ассортимент на дату.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorefrontDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PlainTextError"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "CompanyId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Id компании (салона или магазина).",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "PhotoId": {
        "name": "photoId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ShopId": {
        "name": "shopId",
        "in": "path",
        "required": true,
        "description": "Id магазина (Company.Id компании типа Orders). Id салона → 404.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Slug": {
        "name": "slug",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "responses": {
      "PlainTextError": {
        "description": "Осознанный отказ — голая строка по-русски.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "PlainTextConflict": {
        "description": "409 маршрута /api/companies/* — голая строка по-русски.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Нет или недействителен токен. Тело пустое."
      },
      "Forbidden": {
        "description": "Нет прав. Тело пустое."
      },
      "NotFound": {
        "description": "Не найдено. Тело пустое."
      },
      "NoContent": {
        "description": "Выполнено, тела нет."
      },
      "PayloadTooLarge": {
        "description": "Тело больше RequestSizeLimit (5 МБ). Тело пустое."
      },
      "LegalGate": {
        "description": "Требуется принять новую редакцию правовых документов владельца.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          },
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Превышен лимит частоты — голая строка по-русски.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "schemas": {
      "CompanyKind": {
        "type": "string",
        "enum": [
          "Services",
          "Orders"
        ]
      },
      "ShopRole": {
        "type": "string",
        "enum": [
          "Owner",
          "Staff",
          "SuperAdmin"
        ]
      },
      "ShopAcceptanceMode": {
        "type": "string",
        "description": "Accepting — принимаем; Paused — пауза до pausedUntilUtc; Stopped — «не принимаем, пока не включу».",
        "enum": [
          "Accepting",
          "Paused",
          "Stopped"
        ]
      },
      "ShopNotAcceptingCode": {
        "type": "string",
        "enum": [
          "Blocked",
          "NoWorkingHours",
          "Stopped",
          "Paused",
          "NotAllowedByPlan",
          "MonthlyLimitReached",
          "NoPickupTimeAvailable"
        ]
      },
      "OrderLimitWarningLevel": {
        "type": "string",
        "enum": [
          "None",
          "Warning80",
          "Reached"
        ]
      },
      "StorefrontUnavailableReason": {
        "type": "string",
        "enum": [
          "SoldOut",
          "InsufficientStock",
          "ShopNotAccepting"
        ]
      },
      "ShopCustomerMode": {
        "type": "string",
        "enum": [
          "Anyone",
          "VerifiedPhoneOnly"
        ]
      },
      "OrderAcceptanceMode": {
        "type": "string",
        "enum": [
          "Manual",
          "Auto"
        ]
      },
      "ProductUnit": {
        "type": "string",
        "enum": [
          "Piece",
          "Weight"
        ]
      },
      "CompanyPhotoDto": {
        "type": "object",
        "required": [
          "id",
          "url",
          "thumbnailUrl",
          "width",
          "height",
          "position",
          "isCover"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "description": "Полноразмерная (до 1600 px), публичный класс хранения.",
            "example": "/uploads/companies/9f1c2b7e-0000-4000-8000-000000000001.jpg"
          },
          "thumbnailUrl": {
            "type": "string",
            "description": "Миниатюра (до 480 px). Кабинет показывает её.",
            "example": "/uploads/companies/3a7b1d40-0000-4000-8000-000000000002.jpg"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9,
            "description": "0-based порядок показа; 0 — обложка."
          },
          "isCover": {
            "type": "boolean",
            "description": "position == 0."
          }
        }
      },
      "ReorderCompanyPhotosDto": {
        "type": "object",
        "required": [
          "photoIds"
        ],
        "properties": {
          "photoIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "description": "ПОЛНАЯ перестановка текущих фото компании; первый — обложка.",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "UpdateCompanyProfileInput": {
        "type": "object",
        "additionalProperties": true,
        "description": "Подмножество UpdateCompanyDto, которым пользуется профиль магазина (салонные поля — горизонт записи, флаги\nи т. п. — остаются, но здесь не описаны). Отсутствующее поле или null — «не менять», КРОМЕ ссылок карт\n(пустая строка = очистить) и timeZoneId (явный null = пояс города). Для магазина фронт timeZoneId не шлёт.\n",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "description": "Каноническая форма 7XXXXXXXXXX или пустая строка."
          },
          "email": {
            "type": "string"
          },
          "cityId": {
            "type": "integer",
            "minimum": 1,
            "description": "Смена города. Для магазина пояс всегда следует за городом."
          },
          "timeZoneId": {
            "type": "string",
            "nullable": true,
            "description": "Салон: ручной IANA-пояс / null — пояс города. Магазин: значение, отличное от пояса города → 400."
          },
          "yandexMapsUrl": {
            "type": "string",
            "maxLength": 600,
            "description": "\"\" — удалить ссылку; иначе https-ссылка на Яндекс Карты."
          },
          "twoGisUrl": {
            "type": "string",
            "maxLength": 600,
            "description": "\"\" — удалить ссылку; иначе https-ссылка на 2ГИС."
          }
        }
      },
      "SaveCompanyAddressInput": {
        "type": "object",
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "type": "string",
            "maxLength": 300,
            "description": "Пишется байт в байт; \"\" — очистить."
          },
          "verify": {
            "type": "boolean",
            "nullable": true,
            "description": "Принимается и игнорируется (цикл 19)."
          }
        }
      },
      "CompanyProfileDto": {
        "type": "object",
        "additionalProperties": true,
