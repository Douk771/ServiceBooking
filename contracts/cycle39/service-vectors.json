  "format": {
    "_rule": "ServiceTimeFormat. Гостю (ЮР39-8): «дн д мес, ЧЧ:ММ — ЧЧ:ММ» в одних сутках; при переходе через полночь — вторая календарная дата; старт после полуночи — календарная дата старта. Персоналу (SPEC §4.9): «Дн, д мес · ЧЧ:ММ – ЧЧ:ММ (дн)» на бизнес-дне старта. Список стартов гостю: время, у стартов после полуночи — « (ночь на дн)». Окно в редакторе — «ЧЧ:ММ – ЧЧ:ММ (след. дня)».",
    "cases": [
      { "id": "F01", "businessDate": "2027-01-15", "startMinute": 1320, "hours": 3, "expectedGuest": "пт 15 янв, 22:00 — сб 16 янв, 01:00", "expectedStaff": "Пт, 15 янв · 22:00 – 01:00 (сб)", "expectedStartLabel": "22:00" },
      { "id": "F02", "businessDate": "2027-01-15", "startMinute": 1470, "hours": 2, "expectedGuest": "сб 16 янв, 00:30 — 02:30", "expectedStaff": "Пт, 15 янв · 00:30 (ночь на сб) – 02:30", "expectedStartLabel": "00:30 (ночь на сб)" },
      { "id": "F03", "businessDate": "2027-01-15", "startMinute": 1080, "hours": 3, "expectedGuest": "пт 15 янв, 18:00 — 21:00", "expectedStaff": "Пт, 15 янв · 18:00 – 21:00", "expectedStartLabel": "18:00" },
      { "id": "F04", "businessDate": "2026-12-31", "startMinute": 1380, "hours": 2, "expectedGuest": "чт 31 дек, 23:00 — пт 1 янв, 01:00", "expectedStaff": "Чт, 31 дек · 23:00 – 01:00 (пт)", "expectedStartLabel": "23:00" },
      { "id": "F05", "businessDate": "2027-01-15", "startMinute": 1320, "hours": 2, "expectedGuest": "пт 15 янв, 22:00 — сб 16 янв, 00:00", "expectedStaff": "Пт, 15 янв · 22:00 – 00:00 (сб)", "expectedStartLabel": "22:00" }
    ],
    "businessDateLabel": [
      { "id": "FD01", "businessDate": "2027-01-15", "expected": "пт 15 янв" },
      { "id": "FD02", "businessDate": "2026-12-31", "expected": "чт 31 дек" }
