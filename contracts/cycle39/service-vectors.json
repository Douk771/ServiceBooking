  "reminderTemplate": {
    "_rule": "ArrivalReminderTemplate (ARCHITECTURE_CYCLE39.md §39.11). template = null → мессенджер — прежний текст StayNotificationTexts (байт-в-байт), push — прежний фиксированный, страница — рендер Default в режиме страницы. Рендер: строки; строка с подстановкой, запрещённой в режиме, выпадает; строка с пустым значением подстановки выпадает; push — жёсткий фильтр текста владельца (подстановки вырезаны): Digits (≥ 4 цифр подряд, пробелы/дефисы между ними допустимы) → Link → Email → Phone → CodeWord; мессенджер — в конец строка «Бронь: <url>», если в шаблоне нет {СсылкаНаБронь}, затем пустая строка и «Отписаться от сообщений: <url>». Push — только при pushTextEnabled и шаблоне ≠ null; ≤ 180 символов с «…»; пусто → фиксированный. Порядок причин выпадения: ForbiddenPlaceholder → EmptyValue → Digits → Link → Email → Phone → CodeWord. Сумма — StaysTexts.Rub (обычный пробел-разделитель тысяч).",
    "defaultTemplate": "{Компания}: завтра заезд в «{Дом}» — {ДатаЗаезда} с {ВремяЗаезда}.\nАдрес: {Адрес}.\nК оплате при заселении: {КОплатеПриЗаселении}.\nБронь: {СсылкаНаБронь}",
    "fixedPush": "Завтра заезд — откройте бронь",
    "facts": {
      "companyName": "Кедр Парк", "houseName": "Кедр", "checkInDate": "2027-01-15", "checkOutDate": "2027-01-18", "nights": 3,
      "checkInTime": "14:00", "checkOutTime": "12:00", "guestName": "Анна", "address": "ул. Лесная, 5", "companyPhone": "+7 900 000-00-00",
      "dueAtCheckInRub": 12500, "bookingUrl": "https://dom.ezbook.ru/b/TOKEN", "unsubscribeUrl": "https://ezbook.ru/u/UNSUB",
      "sessions": [ { "serviceName": "Баня", "businessDate": "2027-01-15", "startMinute": 1320, "hours": 3 } ]
    },
    "cases": [
      { "id": "RT01", "_note": "шаблон не менялся", "template": null, "pushTextEnabled": false,
        "expected": {
          "messenger": "Кедр Парк: завтра заезд в «Кедр» — 15 янв с 14:00. Адрес: ул. Лесная, 5. К оплате при заселении: 12 500 ₽. Бронь: https://dom.ezbook.ru/b/TOKEN\n\nОтписаться от сообщений: https://ezbook.ru/u/UNSUB",
          "page": "Кедр Парк: завтра заезд в «Кедр» — 15 янв с 14:00.\nАдрес: ул. Лесная, 5.\nК оплате при заселении: 12 500 ₽.",
          "push": "Завтра заезд — откройте бронь" } },
      { "id": "RT02", "_note": "шаблон не менялся, нет адреса, остаток 0", "template": null, "pushTextEnabled": true, "factsOverride": { "address": null, "dueAtCheckInRub": 0 },
        "expected": {
          "messenger": "Кедр Парк: завтра заезд в «Кедр» — 15 янв с 14:00. Бронь: https://dom.ezbook.ru/b/TOKEN\n\nОтписаться от сообщений: https://ezbook.ru/u/UNSUB",
          "page": "Кедр Парк: завтра заезд в «Кедр» — 15 янв с 14:00.",
          "push": "Завтра заезд — откройте бронь" } },
      { "id": "RT03", "template": "Здравствуйте, {ИмяГостя}!\nЖдём вас {ДатаЗаезда} с {ВремяЗаезда} в «{Дом}».\nКод от калитки 4512\nАдрес: {Адрес}", "pushTextEnabled": true,
        "expected": {
          "messenger": "Здравствуйте, Анна!\nЖдём вас 15 янв с 14:00 в «Кедр».\nКод от калитки 4512\nАдрес: ул. Лесная, 5\nБронь: https://dom.ezbook.ru/b/TOKEN\n\nОтписаться от сообщений: https://ezbook.ru/u/UNSUB",
          "page": "Здравствуйте, Анна!\nЖдём вас 15 янв с 14:00 в «Кедр».\nКод от калитки 4512\nАдрес: ул. Лесная, 5",
          "push": "Ждём вас 15 янв с 14:00 в «Кедр».",
          "pushDropped": [ { "line": 1, "reason": "ForbiddenPlaceholder" }, { "line": 3, "reason": "Digits" }, { "line": 4, "reason": "ForbiddenPlaceholder" } ],
          "validation": { "errors": [], "confirmationRequired": true, "warnings": [] } } },
      { "id": "RT04", "template": "Wi-Fi и пароль — в информации к заселению\nЗвоните +7 900 111-22-33\nПишите owner@mail.ru\nСайт kedr.ru\nДо встречи, {Компания}!", "pushTextEnabled": true,
        "expected": {
          "push": "До встречи, Кедр Парк!",
          "pushDropped": [ { "line": 1, "reason": "CodeWord" }, { "line": 2, "reason": "Digits" }, { "line": 3, "reason": "Email" }, { "line": 4, "reason": "Link" } ] } },
      { "id": "RT05", "template": "Ждём вас, {Имя}!", "pushTextEnabled": false, "expected": { "validation": { "errors": [ "UnknownPlaceholder" ], "confirmationRequired": false, "warnings": [] } } },
      { "id": "RT06", "template": "Задаток не возвращается", "pushTextEnabled": false, "expected": { "validation": { "errors": [ "ForbiddenWords" ], "confirmationRequired": false, "warnings": [ "CancellationTermsInText" ] } } },
      { "id": "RT07", "template": "Возьмите с собой паспорт", "pushTextEnabled": false, "expected": { "validation": { "errors": [], "confirmationRequired": false, "warnings": [ "Passport" ] } } },
      { "id": "RT08", "templateLength": 701, "pushTextEnabled": false, "expected": { "validation": { "errors": [ "TooLong" ], "confirmationRequired": false, "warnings": [] } } },
      { "id": "RT09", "_note": "push включён, но все строки выпали — фиксированный push", "template": "Ключница: 2580\nhttps://kedr.ru/rules", "pushTextEnabled": true,
        "expected": { "push": "Завтра заезд — откройте бронь", "pushDropped": [ { "line": 1, "reason": "Digits" }, { "line": 2, "reason": "Link" } ] } },
      { "id": "RT10", "_note": "шаблон изменён, push выключен — фиксированный push", "template": "Ждём вас в «{Дом}»!", "pushTextEnabled": false,
        "expected": { "push": "Завтра заезд — откройте бронь", "messenger": "Ждём вас в «Кедр»!\nБронь: https://dom.ezbook.ru/b/TOKEN\n\nОтписаться от сообщений: https://ezbook.ru/u/UNSUB", "page": "Ждём вас в «Кедр»!" } },
      { "id": "RT11", "_note": "{Услуги} — календарными датами", "template": "Ждём вас в «{Дом}»!\nУслуги: {Услуги}", "pushTextEnabled": true,
        "expected": { "push": "Ждём вас в «Кедр»!\nУслуги: Баня, пт 15 янв, 22:00 — сб 16 янв, 01:00", "page": "Ждём вас в «Кедр»!\nУслуги: Баня, пт 15 янв, 22:00 — сб 16 янв, 01:00" } },
      { "id": "RT12", "_note": "без сеансов строка с {Услуги} выпадает", "template": "Ждём вас в «{Дом}»!\nУслуги: {Услуги}", "pushTextEnabled": true, "factsOverride": { "sessions": [] },
        "expected": { "push": "Ждём вас в «Кедр»!", "pushDropped": [ { "line": 2, "reason": "EmptyValue" } ] } },
      { "id": "RT13", "_note": "время из подстановки не роняет строку (фильтр — по тексту владельца)", "template": "Заезд {ДатаЗаезда} с {ВремяЗаезда}, выезд {ДатаВыезда} до {ВремяВыезда}", "pushTextEnabled": true,
        "expected": { "push": "Заезд 15 янв с 14:00, выезд 18 янв до 12:00" } }
    ],
    "pushLength": { "_rule": "Push длиннее 180 символов обрезается до 179 символов + «…» (суррогатные пары не режутся).", "maxLength": 180 }
  }
}
