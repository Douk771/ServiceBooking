              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogListingConflictDto"
                }
              }
            }
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "451": {
            "$ref": "#/components/responses/LegalGate"
          }
        }
      }
