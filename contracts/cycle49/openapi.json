                  "checklist": [
                    {
                      "code": "NoActiveServices",
                      "text": "Есть услуги",
                      "done": false
                    },
                    {
                      "code": "NoServiceProviders",
                      "text": "Есть сотрудники, оказывающие услуги",
                      "done": true
                    },
                    {
                      "code": "HiddenByOwner",
                      "text": "Показ включен в настройках",
                      "done": true
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/PlainTextError"
          },
          "451": {
            "$ref": "#/components/responses/LegalGate"
          }
        }
      },
      "put": {
        "tags": [
          "salon-catalog"
        ],
        "operationId": "putSalonCatalogListingCycle49",
        "summary": "Показывать ли салон в каталоге ezbook.ru — сохраняется сразу (владелец, SuperAdmin)",
        "description": "Порядок проверок без изменений (цикл 31): 401 → 451 → 415/400 (фреймворк) → 404 → 409 text/plain (магазин) →\n400 text/plain «Не указано, показывать ли салон в каталоге» → 409 JSON CatalogListingNotAllowedByPlan\n(включение при тарифе без показа) → 200. Включить показ МОЖНО без услуг и без оказывающих услуги — ответ 200,\nvisible=false, невыполненные пункты видны в checklist. Других причин для 409 нет.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogListingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Сохранено; состояние показа после сохранения.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalonCatalogListingDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PlainTextError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Два случая с разным телом:\n  * text/plain — компания является магазином (CompanyKindGuard);\n  * application/json — тариф не разрешает показ (включить нельзя).\n",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Это магазин: записи, услуги и расписание для него недоступны."
